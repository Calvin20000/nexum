{
  "expo": {
    "name": "Fumiliber",
    "slug": "nexum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fumiliber-mark-icon.png",
    "scheme": "nexum",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fumiliber.app",
      "infoPlist": {
        "NSCameraUsageDescription": "写真を送信するためにカメラを使用します",
        "NSPhotoLibraryUsageDescription": "写真を送信するためにフォトライブラリを使用します",
        "NSPhotoLibraryAddUsageDescription": "写真を保存するために使用します"
      }
    },
    "android": {
      "package": "com.fumiliber.app",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/fumiliber-mark-icon.png",
        "backgroundColor": "#003CFF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/fumiliber-mark-icon.png",
          "color": "#1976D2",
          "sounds": [],
          "mode": "production"
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "画像を送信するために写真へのアクセスを許可します。"
        }
      ],
      "expo-location",
      "expo-localization",
      [
        "expo-calendar",
        {
          "calendarPermission": "Fumiliberの予定をGoogleカレンダーなどと同期するため、カレンダーへのアクセスを使用します。",
          "remindersPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/fumiliber-launch.png",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 300
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ff052dfe-9128-4ac1-8889-03a82c3e963f"
      }
    }
  }
}
